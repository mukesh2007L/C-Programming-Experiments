#include <stdio.h>
#include <string.h>

int main()
{
   char a[100];
   char b[100];
   printf("enter str a");
   scanf("%s",a);
   printf("enter str b");
   scanf("%s",b);
   int len1= strlen(a);
   int len2= strlen(b);
   char c[len1+len2];
   int i=0;
   while(i<(len1+len2))
   {
       if(i<len1)
       c[i]=a[i];
       else
       c[i]=b[i-len1];
       i++;
   }
   printf("%s",c);
  return 0;
}
