#include <stdio.h>

struct Employee {
    char name[50];
    int id;
    float salary;
}e;

int main() {
    

    printf("Enter name: ");
    scanf("%s", e.name);
    printf("Enter employee ID: ");
    scanf("%d", &e.id);
    printf("Enter salary: ");
    scanf("%f", &e.salary);

    printf("\nEmployee Details:\n");
    printf("Name: %s\nID: %d\nSalary: %.2f\n", e.name, e.id, e.salary);
    return 0;
}
