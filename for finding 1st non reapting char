#include <stdio.h>
#include <string.h>

int main() {
    char a[] = "epea";
    int i, j;
    int len = strlen(a);  // len = 4

    for (i = 0; i < len; i++) {       
        for (j =0; j < len; j++) {    
            if (i != j && a[i] == a[j])  
                break;   
               
        }
        
        if (j == len) { 
            printf("%c", a[i]); 
            break;              
        }
    }
}
