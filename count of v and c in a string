#include <stdio.h>

int main() {
    char str[100];
    int vowcount = 0, conscount = 0;
    scanf("%[^\n]s", str);  

    for (int i = 0; str[i] != '\0'; i++) {
        char ch = str[i];
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U') {
            vowcount++;
        }
        else if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
            conscount++;
        }
    }

    printf("Vowels: %d\nConsonants: %d\n", vowcount, conscount);

    return 0;
}
