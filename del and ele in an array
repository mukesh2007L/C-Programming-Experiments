#include <stdio.h>

int main()
{
   int n,i;
   scanf("%d",&n);
   int arr[100];
   for(i=0;i<n;i++)
   scanf("%d",&arr[i]);
   int pos,informer=n;
   printf("enter position");
   scanf("%d",&pos);
   if(pos>informer)
   printf("not available");
   else
   {
    for(i=pos-1;i<informer;i++)
        arr[i]=arr[i+1];
    informer--;
   }
    for(i=0;i<informer;i++)
    printf("%d",arr[i]);
    return 0;
}     
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
 
