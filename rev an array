#include <stdio.h>

int main()
{
   int n,i,j;
   scanf("%d",&n);
   int arr[n];
   for(i=0;i<n;i++)
   scanf("%d",&arr[i]);
   i=0,j=n-1;
   for(i=0;i<j;i++)
   {
       int temp=arr[i];
       arr[i]=arr[j];
       arr[j]=temp;
       j--;
   }
   for(i=0;i<n;i++)
   printf(" %d",arr[i]);

    return 0;
}
