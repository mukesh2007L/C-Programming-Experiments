#include <stdio.h>

int main()
{
     int n,i,pos,ele;
     scanf("%d",&n);
     int a[100];
     for(i=0;i<n;i++)
      scanf("%d",&a[i]);
     int informer=n;
     printf("enter the position to insert");
     scanf("%d",&pos); //3
     printf("enter element to insert ");
     scanf("%d",&ele);
     if(pos>informer) 
     printf("not available");
     else
     {
         for(i=informer;i>=pos-1;i--)
         a[i+1]=a[i];
         a[pos-1]=ele;
         informer++;
     }
     for(i=0;i<informer;i++)
     printf(" %d",a[i]);
     
       return 0;  
     }
       

