#include <stdio.h>

int main()
{
 int n,i;
 scanf("%d",&n);
 int arr[n];
 for(i=0;i<n;i++)      //0 1 2 3 4 
 scanf("%d",&arr[i]); //1 2 3 4 5
 int *ptr1,*ptr2;
 ptr1=arr;
 ptr2=&arr[n-1];
 while(ptr1<ptr2)
 {
     int temp=*ptr1;
     *ptr1=*ptr2;
     *ptr2=temp;
     ptr1++;
     ptr2--;
 }
 for(i=0;i<n;i++)
 printf(" %d",arr[i]);
 
 
 
 
 

    return 0;
}
